# Copy to .env and fill in.

# Postgres connection string. Dokploy provides this in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulse_engine"

# The public URL this is served at. Every OAuth redirect and every internal
# redirect is built from it, so it must match an Authorized redirect URI on the
# Google Cloud OAuth client exactly.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# IANA zone used for every day boundary. Getting this wrong shifts "today".
NEXT_PUBLIC_TIME_ZONE="Europe/London"

# Google Cloud Console, APIs and Services, Credentials, OAuth client of type
# "Web server".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The single password gating the whole site.
APP_PASSWORD=""

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Local only, used by docker-compose for the bundled Postgres.
POSTGRES_PASSWORD="postgres"
