# Copy to .env and fill in values

# PostgreSQL connection string (Dokploy provides this)
DATABASE_URL="postgresql://postgres:password@localhost:5432/health_tracker"

# Public URL this app is deployed at — used to build the OAuth redirect URI
# (must exactly match an Authorized redirect URI on the Google Cloud OAuth client)
NEXT_PUBLIC_BASE_URL="https://health.hamidullah.net"

# From Google Cloud Console > APIs & Services > Credentials (OAuth client, type "Web server")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
